// as5600 — ams's AS5600 12-bit magnetic rotary position sensor, on its I2C
// bus, as devices-nv's `AngleSensor`.
//
// The facts below are from the data sheet "AS5600, 12-Bit Programmable
// Contactless Potentiometer", ams AG, version [v1-06] 2018-Jun-20; the
// copy read names no document number.  The register map is its
// Figure 21, the CONF register its Figure 22, the STATUS register its
// Figure 23.  Where the sheet and the drivers read for this one disagree,
// the site says which was taken.
//
// A magnet on the end of a shaft turns above the chip, which senses the
// direction of its field and converts it to an angle over one full turn.
// The part has one I2C address, 0x36, which does not change.  (The
// AS5600L has the same registers at a programmable address, 0x40 by
// default; it is not this part.)  The registers (Figure 21):
//
//   0x00         ZMCO       burn count of ZPOS and MPOS, bits 1:0, read only
//   0x01, 0x02   ZPOS       zero position, 12 bits
//   0x03, 0x04   MPOS       stop position, 12 bits
//   0x05, 0x06   MANG       maximum angle, 12 bits
//   0x07, 0x08   CONF       bits 13:0; bits 15:14 are the factory's
//   0x0B         STATUS     MH (3) magnet too strong, ML (4) too weak,
//                           MD (5) magnet detected
//   0x0C, 0x0D   RAW ANGLE  12 bits, unscaled and unmodified
//   0x0E, 0x0F   ANGLE      12 bits, after ZPOS, MPOS and MANG
//   0x1A         AGC        automatic gain, 0 to 255 at 5 V, 0 to 128 at 3.3 V
//   0x1B, 0x1C   MAGNITUDE  12 bits, the CORDIC's magnitude
//   0xFF         BURN       0x80 burns ZPOS and MPOS, 0x40 burns MANG and CONF
//
// A 16-bit value is two bytes, the high byte at the lower address.  The
// upper nibble of the high byte is not part of a 12-bit value.
//
// CONF (Figure 22): PM (1:0) power mode, 0 NOM, 1 LPM1, 2 LPM2, 3 LPM3;
// HYST (3:2) hysteresis, 0 off, 1, 2 or 3 LSBs; OUTS (5:4) output stage,
// 0 analog full range, 1 analog 10% to 90%, 2 PWM; PWMF (7:6) PWM
// frequency, 115, 230, 460 or 920 Hz; SF (9:8) slow filter, 16x, 8x, 4x
// or 2x; FTH (12:10) fast filter threshold, 0 for the slow filter only,
// then 6, 7, 9, 18, 21, 24 and 10 LSBs; WD (13) watchdog.  A change reads
// the register, changes only the wanted bits and writes it back, because
// blank fields may hold factory settings.
//
// The direction (DIR pin): tied to ground the angle increases with
// clockwise rotation, tied to the supply with counterclockwise.  The pin
// must be tied one way and not left floating.  A board that wants to turn
// it in software wires it to a GPIO, and `attach_with_dir` gives the
// driver that pin.
//
// Fix kept (the pointer rule, "Automatic Increment of the Address Pointer
// for ANGLE, RAW ANGLE and MAGNITUDE Registers"): reads of these three
// registers suppress the pointer's increment so that a re-read needs no
// write, and the rule holds only when the pointer is at the high byte.
// The consequence is that after the low byte of one of them the pointer is
// back at the high byte, and a burst that runs from STATUS (0x0B) through
// RAW ANGLE into ANGLE reads RAW ANGLE twice.  The devices-nv reference
// double reads 0x0B to 0x0F in one transaction; this driver reads the
// status and the angle in two, and reads each 12-bit value alone.  Zephyr's
// `drivers/sensor/ams/ams_as5600` reads the status and the raw angle in
// two transactions too.
//
// Fix kept: Zephyr's driver reads RAW ANGLE, which ignores the zero and
// the range the program set, and refuses a reading whenever the magnet is
// weak or strong.  `AngleSensor` asks for the angle after the zero, and
// a weak or strong magnet gives a usable angle that is less accurate, so
// the reading carries the status and keeps the angle.
//
// Fix kept: after a write to a register "the new setting is effective at
// the output at least 1 ms later"; the ANGLE register follows ZPOS only
// then.  `SETTLE_US` is that time, and the filters add their own
// settling time (`settling_us`).
//
// The burn commands (BURN, 0xFF: 0x80 for ZPOS and MPOS, 0x40 for MANG and
// CONF) are NOT IMPLEMENTED, on purpose.  They write the part's one-time
// programmable memory: ZMCO counts the burns of ZPOS and MPOS, the sheet
// allows three, and MANG and CONF can be burned once, MANG only while ZMCO
// is 0.  A burn cannot be undone.  `burn_count` reads ZMCO, and a program
// that must burn follows the sheet's Figures 24 and 26 by hand, with the
// 10 uF capacitor on VDD3V3 that the sheet asks for during programming.
//
// A bus enters through `As5600Port`, which a type that holds a bus
// implements: `As5600I2c` for the board's I2C bus.  The framing is the
// functions `i2c_read_into` and `i2c_write`, generic over `I2cBus`, so a
// test runs them over a double of the bus.

use embedded_hal.{ BoardI2c, BoardGpio, I2cBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_angle.{ MagnetStatus, AngleReading, AngleSensor }

// The registers (Figure 21).
let REG_ZMCO   = 0x00
let REG_ZPOS   = 0x01
let REG_MPOS   = 0x03
let REG_MANG   = 0x05
let REG_CONF   = 0x07
let REG_STATUS = 0x0B
let REG_RAW    = 0x0C
let REG_ANGLE  = 0x0E
let REG_AGC    = 0x1A

// The STATUS bits (Figure 23).
let ST_MH = 0x08
let ST_ML = 0x10
let ST_MD = 0x20

// The I2C address of the part: 0x36, fixed.
pub const ADDRESS = 0x36

// The clock `setup` asks for: fast mode.  The part supports fast mode
// plus, up to 1 MHz.
let I2C_HZ = 400000

// The time the part takes from power-up to its first valid angle, in
// microseconds: T_PU, 10 ms.
pub const POWER_UP_US = 10000

// The time a new register setting takes to reach the angle, in
// microseconds: the 1 ms after "each register command".
pub const SETTLE_US = 1000

// The time between two angles the part computes, in microseconds: F_S,
// 150 us.
pub const SAMPLE_US = 150

// The smallest angular range the part accepts, in counts: the sheet says
// "greater than 18 degrees", which is more than 204.8 counts of 4096.
pub const RANGE_MIN = 205

// The largest 12-bit value.
let MAX12 = 0xFFF

// The power modes of CONF.PM: NOM is the part always converting, and the
// LPM modes poll every 5, 20 and 100 ms.
pub const PM_NOM  = 0
pub const PM_LPM1 = 1
pub const PM_LPM2 = 2
pub const PM_LPM3 = 3

// The output stages of CONF.OUTS: the analog output over the full supply
// range, over 10% to 90% of it, and the PWM output.
pub const OUT_ANALOG_FULL    = 0
pub const OUT_ANALOG_REDUCED = 1
pub const OUT_PWM            = 2

// The CONF fields.
pub @value
struct As5600Conf
    power_mode: Int
    hysteresis: Int
    output_stage: Int
    pwm_freq: Int
    slow_filter: Int
    fast_threshold: Int
    watchdog: Bool

// The gain and the magnitude, which say how well the part sees the magnet.
// For the most robust reading the gain sits in the middle of its range.
pub @value
struct As5600Gain
    agc: Int
    magnitude: Int

// ZMCO and the configuration registers in one read: the burn count, ZPOS,
// MPOS, MANG and the whole CONF register.
pub @value
struct As5600Settings
    zmco: Int
    zpos: Int
    mpos: Int
    mang: Int
    conf_raw: Int

// A bus the part is on.  `setup` makes the bus ready and the DIR pin an
// output; `read_regs` reads `n` registers from `reg` in one transaction;
// `write_regs` writes the bytes of `src` from `reg` in one transaction;
// `direction` drives the DIR pin, 0 for clockwise and 1 for
// counterclockwise, and answers whether the wiring gave it one.
pub trait As5600Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
    fn direction(self, level: Int) -> Bool [hw]

// ── The bus ──────────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes the bytes of `src` from the register `reg` in one I2C
// transaction: whether the part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, src: DevBytes) -> Bool [hw]
    dev_bus.wiring_write_from(bus, w, reg, src)

// Makes the I2C bus ready: the bus at 400 kHz, and the DIR pin, when the
// board gives one, an output driven low, which is clockwise.  Answers
// whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, dir: ?Int) -> Bool [hw]
    if let Some(pin) = dir
        gpio.set(pin, 0)
        gpio.mode(pin, 1)
    bus.init(I2C_HZ)
    w.addr != None

// Drives the DIR pin: 0 is clockwise (the angle increases with
// clockwise rotation) and 1 counterclockwise.  Answers whether the board
// gave the driver a pin.
pub fn dir_drive<G: GpioOut>(gpio: G, dir: ?Int, level: Int) -> Bool [hw]
    let Some(pin) = dir else return false
    gpio.set(pin, level)
    true

// ── Register access ──────────────────────────────────────────────────

// The register `reg`, or `None` when the part did not answer.
pub fn reg_read<P: As5600Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// The 12-bit value at the high byte `reg`, or `None` when the part did not
// answer.  The two bytes are read in one transaction, as the pointer rule
// of the header needs.
pub fn word12_read<P: As5600Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 2, var b)
        return None
    Some(((b[0] as Int << 8) | b[1] as Int) & MAX12)

// Writes the 12-bit value `v` at the high byte `reg` and reads it back:
// whether the part holds it.  A value outside 0 to 4095 is refused.
pub fn word12_write<P: As5600Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if v < 0 or v > MAX12
        return false
    var src: DevBytes = Vec.new()
    let _ = src.push(((v >> 8) & 0x0F) as u8)
    let _ = src.push((v & 0xFF) as u8)
    if not p.write_regs(reg, src)
        return false
    word12_read(p, reg) == Some(v)

// ── Status and angle ─────────────────────────────────────────────────

// The STATUS register, or `None` when the part did not answer.
pub fn status_read<P: As5600Port>(p: P) -> ?Int [hw]
    reg_read(p, REG_STATUS)

// What a STATUS value says about the magnet: not detected, too strong, too
// weak, or in range.
pub fn magnet_of(status: Int) -> MagnetStatus
    if (status & ST_MD) == 0
        return MagnetMissing
    if (status & ST_MH) != 0
        return MagnetStrong
    if (status & ST_ML) != 0
        return MagnetWeak
    MagnetOk

// The raw angle, 0 to 4095 over a turn, before ZPOS and the range.
pub fn raw_angle_read<P: As5600Port>(p: P) -> ?Int [hw]
    word12_read(p, REG_RAW)

// The angle after ZPOS, MPOS and MANG, 0 to 4095 over the range.
pub fn angle_value_read<P: As5600Port>(p: P) -> ?Int [hw]
    word12_read(p, REG_ANGLE)

// The angle with the status of the magnet: the status first, then the
// angle, in two transactions.  With no magnet detected the angle is 0.
// `None` when the part did not answer.
pub fn angle_read_of<P: As5600Port>(p: P) -> ?AngleReading [hw]
    let Some(status) = status_read(p) else return None
    let m = magnet_of(status)
    if m == MagnetMissing
        return Some(AngleReading { counts: 0, magnet: m })
    let Some(counts) = angle_value_read(p) else return None
    Some(AngleReading { counts: counts, magnet: m })

// The gain and the magnitude in one transaction of three registers.
pub fn gain_read<P: As5600Port>(p: P) -> ?As5600Gain [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(REG_AGC, 3, var b)
        return None
    Some(As5600Gain { agc: b[0] as Int, magnitude: ((b[1] as Int << 8) | b[2] as Int) & MAX12 })

// The largest AGC value: 255 at a 5 V supply and 128 at 3.3 V.
pub fn agc_full_scale(supply_3v3: Bool) -> Int
    if supply_3v3
        return 128
    255

// The number of times ZPOS and MPOS were burned, 0 to 3, or `None` when
// the part did not answer.
pub fn burn_count<P: As5600Port>(p: P) -> ?Int [hw]
    let Some(z) = reg_read(p, REG_ZMCO) else return None
    Some(z & 0x03)

// ── The zero and the range ───────────────────────────────────────────

// Makes the part report `count`, a RAW ANGLE count, as angle 0: writes ZPOS
// and reads it back.  `count` is 0 to 4095.  The setting holds until the
// part is reset, and reaches the angle `SETTLE_US` later.
pub fn zpos_write<P: As5600Port>(p: P, count: Int) -> Bool [hw]
    word12_write(p, REG_ZPOS, count)

// Sets the stop position MPOS: the angle where the output ends.
pub fn mpos_write<P: As5600Port>(p: P, count: Int) -> Bool [hw]
    word12_write(p, REG_MPOS, count)

// Sets the maximum angle MANG, the size of the range counted from ZPOS.
// 0 gives the full turn; any other value is at least `RANGE_MIN`.
pub fn mang_write<P: As5600Port>(p: P, count: Int) -> Bool [hw]
    if count != 0 and count < RANGE_MIN
        return false
    word12_write(p, REG_MANG, count)

// Makes the current RAW ANGLE the zero: reads it and writes it to ZPOS,
// the sheet's Option A step 2 and 3.
pub fn zero_here_of<P: As5600Port>(p: P) -> Bool [hw]
    let Some(raw) = raw_angle_read(p) else return false
    zpos_write(p, raw)

// Sets the range from ZPOS to MPOS: both written and read back.  The span,
// counted from `zpos` to `mpos` in the direction of rotation, has to be at
// least `RANGE_MIN` counts.
pub fn range_write<P: As5600Port>(p: P, zpos: Int, mpos: Int) -> Bool [hw]
    if zpos < 0 or zpos > MAX12 or mpos < 0 or mpos > MAX12
        return false
    if ((mpos - zpos) & MAX12) < RANGE_MIN
        return false
    zpos_write(p, zpos) and mpos_write(p, mpos)

// ZMCO, ZPOS, MPOS, MANG and CONF in one transaction of nine registers.
pub fn settings_read<P: As5600Port>(p: P) -> ?As5600Settings [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(REG_ZMCO, 9, var b)
        return None
    Some(As5600Settings {
        zmco: (b[0] as Int) & 0x03,
        zpos: ((b[1] as Int << 8) | b[2] as Int) & MAX12,
        mpos: ((b[3] as Int << 8) | b[4] as Int) & MAX12,
        mang: ((b[5] as Int << 8) | b[6] as Int) & MAX12,
        conf_raw: (b[7] as Int << 8) | b[8] as Int })

// ── The configuration ────────────────────────────────────────────────

// The fields of a raw CONF value (Figure 22).
pub fn conf_of(raw: Int) -> As5600Conf
    As5600Conf {
        power_mode: raw & 0x3,
        hysteresis: (raw >> 2) & 0x3,
        output_stage: (raw >> 4) & 0x3,
        pwm_freq: (raw >> 6) & 0x3,
        slow_filter: (raw >> 8) & 0x3,
        fast_threshold: (raw >> 10) & 0x7,
        watchdog: ((raw >> 13) & 1) == 1 }

// The 14 bits of CONF for the fields, 0 in the reserved bits.
pub fn conf_bits(c: As5600Conf) -> Int
    var wd = 0
    if c.watchdog
        wd = 1
    (wd << 13) | ((c.fast_threshold & 7) << 10) | ((c.slow_filter & 3) << 8) | ((c.pwm_freq & 3) << 6) | ((c.output_stage & 3) << 4) | ((c.hysteresis & 3) << 2) | (c.power_mode & 3)

// The 16-bit value at the high byte `reg`, or `None` when the part did not
// answer.
fn word16_read<P: As5600Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 2, var b)
        return None
    Some((b[0] as Int << 8) | b[1] as Int)

// The CONF register, or `None` when the part did not answer.
pub fn conf_read<P: As5600Port>(p: P) -> ?As5600Conf [hw]
    let Some(raw) = word16_read(p, REG_CONF) else return None
    Some(conf_of(raw))

// Writes the 16 bits `v` to CONF and reads them back: whether the part
// holds the 14 bits that are not reserved.
fn conf_store<P: As5600Port>(p: P, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push(((v >> 8) & 0xFF) as u8)
    let _ = src.push((v & 0xFF) as u8)
    if not p.write_regs(REG_CONF, src)
        return false
    match word16_read(p, REG_CONF)
        Some(back) => (back & 0x3FFF) == (v & 0x3FFF)
        None => false

// Writes the 14 bits of `c` to CONF and keeps the two reserved bits the
// part holds: whether the part holds what was written.
pub fn conf_write<P: As5600Port>(p: P, c: As5600Conf) -> Bool [hw]
    let Some(raw) = word16_read(p, REG_CONF) else return false
    conf_store(p, (raw & 0xC000) | conf_bits(c))

// Changes one field of CONF: reads the register, replaces the `width` bits
// at `shift` with `value` and writes it back.  A value that does not fit
// the width is refused.
pub fn conf_field_write<P: As5600Port>(p: P, shift: Int, width: Int, value: Int) -> Bool [hw]
    let mask = (1 << width) - 1
    if value < 0 or value > mask
        return false
    let Some(raw) = word16_read(p, REG_CONF) else return false
    conf_store(p, (raw & (0xFFFF ^ (mask << shift))) | (value << shift))

// Sets the power mode, 0 to 3: NOM, LPM1, LPM2 and LPM3, which poll the
// magnet every 5, 20 and 100 ms.
pub fn power_mode_write<P: As5600Port>(p: P, mode: Int) -> Bool [hw]
    conf_field_write(p, 0, 2, mode)

// Sets the hysteresis, 0 to 3 LSBs.
pub fn hysteresis_write<P: As5600Port>(p: P, lsb: Int) -> Bool [hw]
    conf_field_write(p, 2, 2, lsb)

// Sets the output stage: 0 analog over the full range, 1 analog over 10%
// to 90%, 2 PWM.  The sheet defines no other.
pub fn output_stage_write<P: As5600Port>(p: P, stage: Int) -> Bool [hw]
    if stage > OUT_PWM
        return false
    conf_field_write(p, 4, 2, stage)

// Sets the PWM frequency code, 0 to 3 for 115, 230, 460 and 920 Hz.
pub fn pwm_freq_write<P: As5600Port>(p: P, code: Int) -> Bool [hw]
    conf_field_write(p, 6, 2, code)

// Sets the slow filter code, 0 to 3 for 16x, 8x, 4x and 2x.
pub fn slow_filter_write<P: As5600Port>(p: P, code: Int) -> Bool [hw]
    conf_field_write(p, 8, 2, code)

// Sets the fast filter threshold code, 0 to 7: the slow filter only, or a
// threshold of 6, 7, 9, 18, 21, 24 or 10 LSBs.
pub fn fast_filter_write<P: As5600Port>(p: P, code: Int) -> Bool [hw]
    conf_field_write(p, 10, 3, code)

// Turns the watchdog on or off.  On, the part enters LPM3 when the angle
// stays within 4 LSBs for a minute (the AS5600L sheet, v1-12; the v1-06
// sheet gives only the one-minute detection time).
pub fn watchdog_write<P: As5600Port>(p: P, on: Bool) -> Bool [hw]
    var v = 0
    if on
        v = 1
    conf_field_write(p, 13, 1, v)

// The PWM frequency of a code in hertz: 115, 230, 460 and 920; 0 for a
// code outside 0 to 3.
pub fn pwm_hz(code: Int) -> Int
    if code < 0 or code > 3
        return 0
    115 << code

// The slow filter of a code as its factor: 16, 8, 4 and 2; 0 outside 0 to 3.
pub fn slow_filter_factor(code: Int) -> Int
    if code < 0 or code > 3
        return 0
    16 >> code

// The fast filter threshold of a code in LSBs: 0 for the slow filter only,
// 6, 7, 9, 18, 21, 24 and 10; -1 outside 0 to 7.
pub fn fast_threshold_lsb(code: Int) -> Int
    if code == 0
        return 0
    if code == 1
        return 6
    if code == 2
        return 7
    if code == 3
        return 9
    if code == 4
        return 18
    if code == 5
        return 21
    if code == 6
        return 24
    if code == 7
        return 10
    -1

// The settling time of the slow filter code in microseconds, the data
// sheet's T_SETTL: 2.2, 1.1, 0.55 and 0.286 ms; -1 outside 0 to 3.
pub fn settling_us(code: Int) -> Int
    if code == 0
        return 2200
    if code == 1
        return 1100
    if code == 2
        return 550
    if code == 3
        return 286
    -1

// ── Bring-up ─────────────────────────────────────────────────────────

// Brings the part up: the bus made ready and the STATUS register read.
// Answers whether the part answered.  The caller has waited `POWER_UP_US`
// since power-on.
pub fn start<P: As5600Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    status_read(p) != None

// ── The part on the board's I2C bus ──────────────────────────────────

// The bus the part is on: the board's I2C bus at `w.addr`, 0x36, and the
// board's GPIO for the DIR pin when it has one.
pub @value
struct As5600I2c
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring
    dir: ?Int

impl As5600Port for As5600I2c
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w, self.dir)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, src)

    fn direction(self, level: Int) -> Bool [hw]
        dir_drive(self.pins, self.dir, level)

// An AS5600 on a board's I2C bus.
pub @value
struct As5600
    port: As5600I2c

impl As5600
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  The DIR pin is tied to ground or to the supply on
    // the board.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> As5600
        As5600 { port: As5600I2c { bus: bus, pins: pins, w: w, dir: None } }

    // The part with its DIR pin on the GPIO `dir_pin`, which `begin` drives
    // low (clockwise) and `set_clockwise` drives.
    fn attach_with_dir(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring, dir_pin: Int) -> As5600
        As5600 { port: As5600I2c { bus: bus, pins: pins, w: w, dir: Some(dir_pin) } }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self.port)

    // Turns the angle's direction: `true` for increasing with clockwise
    // rotation (the DIR pin low), `false` for counterclockwise.  `false`
    // also when the board gave the driver no DIR pin.
    fn set_clockwise(self, clockwise: Bool) -> Bool [hw]
        if clockwise
            return self.port.direction(0)
        self.port.direction(1)

    // The STATUS register: MH 0x08, ML 0x10, MD 0x20.
    fn status(self) -> ?Int [hw]
        status_read(self.port)

    // The RAW ANGLE, 0 to 4095, before the zero and the range.
    fn raw_angle(self) -> ?Int [hw]
        raw_angle_read(self.port)

    // The ANGLE, 0 to 4095, after the zero and the range.
    fn angle(self) -> ?Int [hw]
        angle_value_read(self.port)

    // The AGC and the MAGNITUDE.
    fn gain(self) -> ?As5600Gain [hw]
        gain_read(self.port)

    // ZMCO, ZPOS, MPOS, MANG and CONF.
    fn settings(self) -> ?As5600Settings [hw]
        settings_read(self.port)

    // The times ZPOS and MPOS were burned.
    fn burns(self) -> ?Int [hw]
        burn_count(self.port)

    // Sets ZPOS to a RAW ANGLE count.
    fn set_zpos(self, count: Int) -> Bool [hw]
        zpos_write(self.port, count)

    // Sets MPOS.
    fn set_mpos(self, count: Int) -> Bool [hw]
        mpos_write(self.port, count)

    // Sets MANG; 0 for the full turn, otherwise at least `RANGE_MIN`.
    fn set_mang(self, count: Int) -> Bool [hw]
        mang_write(self.port, count)

    // Sets ZPOS and MPOS together.
    fn set_range(self, zpos: Int, mpos: Int) -> Bool [hw]
        range_write(self.port, zpos, mpos)

    // Makes the current position the zero.
    fn zero_here(self) -> Bool [hw]
        zero_here_of(self.port)

    // The CONF register's fields.
    fn conf(self) -> ?As5600Conf [hw]
        conf_read(self.port)

    // Writes the fields of CONF, keeping the reserved bits.
    fn set_conf(self, c: As5600Conf) -> Bool [hw]
        conf_write(self.port, c)

    // Sets the power mode, 0 to 3.
    fn set_power_mode(self, mode: Int) -> Bool [hw]
        power_mode_write(self.port, mode)

    // Sets the hysteresis, 0 to 3 LSBs.
    fn set_hysteresis(self, lsb: Int) -> Bool [hw]
        hysteresis_write(self.port, lsb)

    // Sets the output stage, 0 to 2.
    fn set_output_stage(self, stage: Int) -> Bool [hw]
        output_stage_write(self.port, stage)

    // Sets the PWM frequency code, 0 to 3.
    fn set_pwm_freq(self, code: Int) -> Bool [hw]
        pwm_freq_write(self.port, code)

    // Sets the slow filter code, 0 to 3.
    fn set_slow_filter(self, code: Int) -> Bool [hw]
        slow_filter_write(self.port, code)

    // Sets the fast filter threshold code, 0 to 7.
    fn set_fast_filter(self, code: Int) -> Bool [hw]
        fast_filter_write(self.port, code)

    // Turns the watchdog on or off.
    fn set_watchdog(self, on: Bool) -> Bool [hw]
        watchdog_write(self.port, on)

impl AngleSensor[hw] for As5600
    // The angle after the zero and the range, 0 to 4095, with the status of
    // the magnet; the angle is 0 with no magnet detected.
    fn angle_read(self) -> ?AngleReading [hw]
        angle_read_of(self.port)

    // Makes the part report the RAW ANGLE count `count`, 0 to 4095, as
    // angle 0: ZPOS, volatile until the part is reset.
    fn angle_set_zero(self, count: Int) -> Bool [hw]
        zpos_write(self.port, count)
