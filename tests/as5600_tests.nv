// as5600_tests — the driver over a double of the part: a register file on an
// I2C bus that answers at 0x36 the way ams's data sheet ([v1-06]
// 2018-Jun-20) says an AS5600 does, with its read-only registers, its
// 12-bit values whose upper nibble is not part of the value, its CONF
// register whose bits 15:14 the factory set, its ANGLE register that
// follows the zero and the range, and its address pointer that goes back
// to the high byte after the low byte of ANGLE, RAW ANGLE and MAGNITUDE,
// so the framing, the settings and the readings are checked on the host,
// one transaction at a time.  The log keeps what the controller sent, in
// a form the tests compare.
//
// Log entries: a write is 1, the address, the bytes sent, -1; a read is 2,
// the address, the register, the count, -1.

use std.test
use embedded_hal.{ BoardI2c, BoardGpio, I2cBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_angle.{ MagnetStatus, AngleReading, AngleSensor }
use as5600
use as5600.{ As5600, As5600I2c, As5600Conf, As5600Gain, As5600Settings, As5600Port }

// ── The double ───────────────────────────────────────────────────────
//
// `regs` is the register file, by address.  `ro` lists registers that
// ignore a write.  `st` is the double's state: 4 is 1 when a part is
// there, 22 the I2C clock, 41 the reads that still answer (-1 for all),
// 42 the writes that are still acknowledged (-1 for all), 60 is 1 when the
// upper nibble of a 12-bit value reads as 0xF, 99 the entries in the log.

struct Chip
    regs: HashMap<Int, Int>
    ro: HashMap<Int, Int>
    st: HashMap<Int, Int>
    log: HashMap<Int, Int>

fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

// The part at power-up with a magnet in range: MD set, CONF at 0xC000 + 0
// (the two reserved bits the factory set), ZPOS, MPOS and MANG zero, and
// a raw angle of 0.
fn chip() -> Chip
    let c = Chip { regs: HashMap.new(), ro: HashMap.new(), st: HashMap.new(), log: HashMap.new() }
    c.regs.insert(0x07, 0xC0)
    c.regs.insert(0x0B, 0x20)
    c.st.insert(4, 1)
    c.st.insert(41, -1)
    c.st.insert(42, -1)
    c

// Appends a value to the log.
fn log_push(c: Chip, v: Int)
    let n = at(c.st, 99)
    c.log.insert(n, v)
    c.st.insert(99, n + 1)

// Empties the log.
fn log_clear(c: Chip)
    c.st.insert(99, 0)

// Sets the raw angle.
fn set_raw(c: Chip, raw: Int)
    c.regs.insert(0x0C, (raw >> 8) & 0x0F)
    c.regs.insert(0x0D, raw & 0xFF)

// A 12-bit value held in two registers.
fn word(c: Chip, reg: Int) -> Int
    ((at(c.regs, reg) << 8) | at(c.regs, reg + 1)) & 0xFFF

// The angle the part computes: the raw angle less ZPOS, scaled over the
// range, which is MANG when it is set, ZPOS to MPOS when that is set, and
// the full turn otherwise (the data sheet's ZPOS/MPOS/MANG registers).
fn angle_of(c: Chip) -> Int
    let raw = word(c, 0x0C)
    let zpos = word(c, 0x01)
    let mpos = word(c, 0x03)
    let mang = word(c, 0x05)
    var range = 4096
    if mang != 0
        range = mang
    elif mpos != 0
        range = (mpos - zpos) & 0xFFF
    let a = ((raw - zpos) & 0xFFF) * 4096 / range
    if a > 4095
        return 4095
    a

// The byte the part answers at `reg`: the angle is computed, the high
// byte of a 12-bit value may carry the upper nibble, and the rest is the
// register file.
fn chip_byte(c: Chip, reg: Int) -> Int
    var v = at(c.regs, reg)
    if reg == 0x0E
        v = (angle_of(c) >> 8) & 0x0F
    if reg == 0x0F
        v = angle_of(c) & 0xFF
    let high = reg == 0x01 or reg == 0x03 or reg == 0x05 or reg == 0x0C or reg == 0x0E or reg == 0x1B
    if high and at(c.st, 60) == 1
        v = v | 0xF0
    v

// A write to one register: read-only registers and the registers the test
// froze ignore it; a 12-bit value keeps four bits in its high byte, CONF
// keeps six and the factory's two.
fn chip_write(c: Chip, reg: Int, b: Int)
    if at(c.ro, reg) == 1
        return
    var ok = reg >= 0x01 and reg <= 0x08
    if reg == 0xFF
        ok = true
    if not ok
        return
    var v = b & 0xFF
    if reg == 0x01 or reg == 0x03 or reg == 0x05
        v = v & 0x0F
    if reg == 0x07
        v = (at(c.regs, 0x07) & 0xC0) | (v & 0x3F)
    c.regs.insert(reg, v)

struct FakeI2c
    c: Chip

impl I2cBus for FakeI2c
    fn init(self, freq: Int) [hw]
        self.c.st.insert(22, freq)

    fn write(self, addr: Int, data: [u8]) -> Bool [hw]
        log_push(self.c, 1)
        log_push(self.c, addr)
        for b in data
            log_push(self.c, b as Int)
        log_push(self.c, -1)
        if addr != 0x36 or at(self.c.st, 4) == 0 or data.len() < 2
            return false
        let left = at(self.c.st, 42)
        if left == 0
            return false
        if left > 0
            self.c.st.insert(42, left - 1)
        var r = data[0] as Int
        for i in 1..data.len()
            chip_write(self.c, r, data[i] as Int)
            r = r + 1
        true

    fn read(self, addr: Int, n: Int) -> ?[u8] [hw]
        None

    // The pointer rule: after the low byte of ANGLE, RAW ANGLE or
    // MAGNITUDE the pointer is back at the high byte, so a read that runs
    // on from there reads the same register again.
    @tier(app)
    fn write_read(self, addr: Int, tx: [u8], n: Int) -> ?[u8] [hw]
        log_push(self.c, 2)
        log_push(self.c, addr)
        log_push(self.c, tx[0] as Int)
        log_push(self.c, n)
        log_push(self.c, -1)
        if addr != 0x36 or at(self.c.st, 4) == 0
            return None
        let left = at(self.c.st, 41)
        if left == 0
            return None
        if left > 0
            self.c.st.insert(41, left - 1)
        var r = tx[0] as Int
        var out: [u8] = []
        for _i in 0..n
            list.push(out, chip_byte(self.c, r) as u8)
            if r == 0x0D or r == 0x0F or r == 0x1C
                r = r - 1
            else
                r = r + 1
        Some(out)

// The GPIO double records the level and the mode of each pin.
struct FakePins
    levels: HashMap<Int, Int>
    modes: HashMap<Int, Int>

impl GpioOut for FakePins
    fn mode(self, pin: Int, dir: Int) [hw]
        self.modes.insert(pin, dir)

    fn set(self, pin: Int, val: Int) [hw]
        self.levels.insert(pin, val)

    fn get(self, pin: Int) -> Int [hw]
        at(self.levels, pin)

@tier(app)
fn pins() -> FakePins
    FakePins { levels: HashMap.new(), modes: HashMap.new() }

// The port, as a type that holds a bus implements it: every method is the
// package's own function over the double.
struct Dut
    bus: FakeI2c
    pins: FakePins
    w: DeviceWiring
    dir: ?Int

impl As5600Port for Dut
    fn setup(self) -> Bool [hw]
        as5600.i2c_setup(self.bus, self.pins, self.w, self.dir)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        as5600.i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
        as5600.i2c_write(self.bus, self.w, reg, src)

    fn direction(self, level: Int) -> Bool [hw]
        as5600.dir_drive(self.pins, self.dir, level)

fn wiring() -> DeviceWiring
    dev_bus.wiring_i2c(0, 0x36)

fn dut(c: Chip) -> Dut
    Dut { bus: FakeI2c { c: c }, pins: pins(), w: wiring(), dir: None }

fn dut_with_dir(c: Chip, pin: Int) -> Dut
    Dut { bus: FakeI2c { c: c }, pins: pins(), w: wiring(), dir: Some(pin) }

// Asserts the log holds exactly `want`, then empties it.
fn log_is(c: Chip, want: [Int])
    test.assert_eq(at(c.st, 99), want.len())
    for i in 0..want.len()
        test.assert_eq(at(c.log, i), want[i])
    log_clear(c)

// The counts of a reading, or -1 when there is none; and its magnet.
fn counts_or(o: ?AngleReading) -> Int
    match o
        Some(r) => r.counts
        None    => -1

fn magnet_or(o: ?AngleReading) -> MagnetStatus
    match o
        Some(r) => r.magnet
        None    => MagnetMissing

fn int_or(o: ?Int) -> Int
    match o
        Some(v) => v
        None    => -1

fn conf_or(o: ?As5600Conf) -> As5600Conf
    match o
        Some(c) => c
        None    => As5600Conf { power_mode: -1,
            hysteresis: -1,
            output_stage: -1,
            pwm_freq: -1,
            slow_filter: -1,
            fast_threshold: -1,
            watchdog: false }

// ── The constants and the tables ─────────────────────────────────────

@test
fn test_the_address_and_the_times_are_the_data_sheets() [io, hw]
    test.assert_eq(as5600.ADDRESS, 0x36)
    test.assert_eq(as5600.POWER_UP_US, 10000)
    test.assert_eq(as5600.SETTLE_US, 1000)
    test.assert_eq(as5600.SAMPLE_US, 150)
    test.assert_eq(as5600.RANGE_MIN, 205)
    test.assert_eq(as5600.PM_NOM, 0)
    test.assert_eq(as5600.PM_LPM1, 1)
    test.assert_eq(as5600.PM_LPM2, 2)
    test.assert_eq(as5600.PM_LPM3, 3)
    test.assert_eq(as5600.OUT_ANALOG_FULL, 0)
    test.assert_eq(as5600.OUT_ANALOG_REDUCED, 1)
    test.assert_eq(as5600.OUT_PWM, 2)

@test
fn test_the_conf_field_tables() [io, hw]
    test.assert_eq(as5600.pwm_hz(0), 115)
    test.assert_eq(as5600.pwm_hz(1), 230)
    test.assert_eq(as5600.pwm_hz(2), 460)
    test.assert_eq(as5600.pwm_hz(3), 920)
    test.assert_eq(as5600.pwm_hz(4), 0)
    test.assert_eq(as5600.pwm_hz(-1), 0)
    test.assert_eq(as5600.slow_filter_factor(0), 16)
    test.assert_eq(as5600.slow_filter_factor(1), 8)
    test.assert_eq(as5600.slow_filter_factor(2), 4)
    test.assert_eq(as5600.slow_filter_factor(3), 2)
    test.assert_eq(as5600.slow_filter_factor(4), 0)
    test.assert_eq(as5600.slow_filter_factor(-1), 0)
    test.assert_eq(as5600.fast_threshold_lsb(0), 0)
    test.assert_eq(as5600.fast_threshold_lsb(1), 6)
    test.assert_eq(as5600.fast_threshold_lsb(2), 7)
    test.assert_eq(as5600.fast_threshold_lsb(3), 9)
    test.assert_eq(as5600.fast_threshold_lsb(4), 18)
    test.assert_eq(as5600.fast_threshold_lsb(5), 21)
    test.assert_eq(as5600.fast_threshold_lsb(6), 24)
    test.assert_eq(as5600.fast_threshold_lsb(7), 10)
    test.assert_eq(as5600.fast_threshold_lsb(8), -1)
    test.assert_eq(as5600.settling_us(0), 2200)
    test.assert_eq(as5600.settling_us(1), 1100)
    test.assert_eq(as5600.settling_us(2), 550)
    test.assert_eq(as5600.settling_us(3), 286)
    test.assert_eq(as5600.settling_us(4), -1)
    test.assert_eq(as5600.agc_full_scale(false), 255)
    test.assert_eq(as5600.agc_full_scale(true), 128)

@test
fn test_the_magnet_status_follows_figure_23() [io, hw]
    test.assert(as5600.magnet_of(0x20) == MagnetOk)
    // MH: too strong; ML: too weak.
    test.assert(as5600.magnet_of(0x28) == MagnetStrong)
    test.assert(as5600.magnet_of(0x30) == MagnetWeak)
    // Both overflow bits cannot be set together; the stronger reading wins.
    test.assert(as5600.magnet_of(0x38) == MagnetStrong)
    // Without MD there is no magnet, whatever the other bits say.
    test.assert(as5600.magnet_of(0x00) == MagnetMissing)
    test.assert(as5600.magnet_of(0x18) == MagnetMissing)

@test
fn test_the_conf_fields_pack_into_14_bits() [io, hw]
    let c = As5600Conf { power_mode: 3,
        hysteresis: 2,
        output_stage: 2,
        pwm_freq: 2,
        slow_filter: 3,
        fast_threshold: 5,
        watchdog: true }
    // WD 1, FTH 101, SF 11, PWMF 10, OUTS 10, HYST 10, PM 11.
    test.assert_eq(as5600.conf_bits(c), 0x37AB)
    let d = as5600.conf_of(0x37AB)
    test.assert_eq(d.power_mode, 3)
    test.assert_eq(d.hysteresis, 2)
    test.assert_eq(d.output_stage, 2)
    test.assert_eq(d.pwm_freq, 2)
    test.assert_eq(d.slow_filter, 3)
    test.assert_eq(d.fast_threshold, 5)
    test.assert(d.watchdog)
    // The reserved bits are not a field.
    let e = as5600.conf_of(0xC000)
    test.assert_eq(e.power_mode, 0)
    test.assert(not e.watchdog)
    let off = As5600Conf { power_mode: 0,
        hysteresis: 0,
        output_stage: 0,
        pwm_freq: 0,
        slow_filter: 0,
        fast_threshold: 0,
        watchdog: false }
    test.assert_eq(as5600.conf_bits(off), 0)

// ── The bus ──────────────────────────────────────────────────────────

@test
fn test_a_read_is_the_register_then_a_repeated_start() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x1A, 77)
    test.assert_eq(int_or(as5600.reg_read(d, 0x1A)), 77)
    log_is(c, [2, 0x36, 0x1A, 1, -1])

@test
fn test_a_write_is_the_register_then_the_bytes() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(as5600.zpos_write(d, 0x123))
    // The write, then the read that confirms it.
    log_is(c, [1, 0x36, 0x01, 0x01, 0x23, -1, 2, 0x36, 0x01, 2, -1])

@test
fn test_a_part_that_is_not_there_does_not_answer() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = dut(c)
    test.assert(as5600.reg_read(d, 0x0B) == None)
    test.assert(as5600.status_read(d) == None)
    test.assert(as5600.raw_angle_read(d) == None)
    test.assert(as5600.angle_value_read(d) == None)
    test.assert(as5600.gain_read(d) == None)
    test.assert(as5600.settings_read(d) == None)
    test.assert(as5600.burn_count(d) == None)
    test.assert(as5600.conf_read(d) == None)
    test.assert(not as5600.zpos_write(d, 5))
    test.assert(not as5600.zero_here_of(d))
    test.assert(not as5600.start(d))
    test.assert(as5600.angle_read_of(d) == None)

@test
fn test_a_wiring_with_no_address_is_not_an_i2c_part() [io, hw]
    let c = chip()
    let d = Dut { bus: FakeI2c { c: c }, pins: pins(), w: dev_bus.wiring_spi(0, 5), dir: None }
    test.assert(not d.setup())
    var b: DevBytes = Vec.new()
    test.assert(not d.read_regs(0x0B, 1, var b))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_setup_makes_the_bus_fast_and_the_dir_pin_an_output_driven_low() [io, hw]
    let c = chip()
    let d = dut_with_dir(c, 12)
    d.pins.levels.insert(12, 1)
    test.assert(d.setup())
    test.assert_eq(at(c.st, 22), 400000)
    test.assert_eq(at(d.pins.levels, 12), 0)
    test.assert_eq(at(d.pins.modes, 12), 1)

@test
fn test_setup_without_a_dir_pin_touches_no_pin() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(d.setup())
    test.assert_eq(d.pins.modes.len(), 0)
    test.assert_eq(d.pins.levels.len(), 0)

@test
fn test_the_direction_pin_is_driven_when_the_board_gave_one() [io, hw]
    let c = chip()
    let d = dut_with_dir(c, 12)
    // Low is clockwise, high counterclockwise.
    test.assert(d.direction(1))
    test.assert_eq(at(d.pins.levels, 12), 1)
    test.assert(d.direction(0))
    test.assert_eq(at(d.pins.levels, 12), 0)
    let n = dut(c)
    test.assert(not n.direction(1))
    test.assert_eq(n.pins.levels.len(), 0)

@test
fn test_the_bring_up_reads_the_status() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(as5600.start(d))
    log_is(c, [2, 0x36, 0x0B, 1, -1])

@test
fn test_the_bring_up_stops_when_the_wiring_suits_no_bus() [io, hw]
    let c = chip()
    let d = Dut { bus: FakeI2c { c: c }, pins: pins(), w: dev_bus.wiring_spi(0, 5), dir: None }
    test.assert(not as5600.start(d))
    test.assert_eq(at(c.st, 99), 0)

// ── The angle ────────────────────────────────────────────────────────

@test
fn test_the_angle_is_read_with_the_status_in_two_transactions() [io, hw]
    let c = chip()
    let d = dut(c)
    set_raw(c, 1234)
    let r = as5600.angle_read_of(d)
    test.assert_eq(counts_or(r), 1234)
    test.assert(magnet_or(r) == MagnetOk)
    log_is(c, [2, 0x36, 0x0B, 1, -1, 2, 0x36, 0x0E, 2, -1])

@test
fn test_the_upper_nibble_of_a_12_bit_value_is_not_part_of_it() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(60, 1)
    set_raw(c, 4095)
    test.assert_eq(counts_or(as5600.angle_read_of(d)), 4095)
    test.assert_eq(int_or(as5600.raw_angle_read(d)), 4095)
    test.assert_eq(int_or(as5600.angle_value_read(d)), 4095)

@test
fn test_the_angle_follows_the_zero_and_the_raw_angle_does_not() [io, hw]
    let c = chip()
    let d = dut(c)
    set_raw(c, 1500)
    test.assert(as5600.zpos_write(d, 1000))
    test.assert_eq(int_or(as5600.raw_angle_read(d)), 1500)
    test.assert_eq(int_or(as5600.angle_value_read(d)), 500)
    // Below the zero the angle wraps through 4095.
    set_raw(c, 900)
    test.assert_eq(int_or(as5600.angle_value_read(d)), 3996)

@test
fn test_a_weak_or_strong_magnet_keeps_its_angle() [io, hw]
    let c = chip()
    let d = dut(c)
    set_raw(c, 321)
    c.regs.insert(0x0B, 0x30)
    let faint = as5600.angle_read_of(d)
    test.assert(magnet_or(faint) == MagnetWeak)
    test.assert_eq(counts_or(faint), 321)
    c.regs.insert(0x0B, 0x28)
    let strong = as5600.angle_read_of(d)
    test.assert(magnet_or(strong) == MagnetStrong)
    test.assert_eq(counts_or(strong), 321)

@test
fn test_no_magnet_is_no_angle_and_one_transaction() [io, hw]
    let c = chip()
    let d = dut(c)
    set_raw(c, 321)
    c.regs.insert(0x0B, 0x00)
    let r = as5600.angle_read_of(d)
    test.assert(magnet_or(r) == MagnetMissing)
    test.assert_eq(counts_or(r), 0)
    log_is(c, [2, 0x36, 0x0B, 1, -1])

@test
fn test_a_part_that_leaves_after_the_status_has_no_reading() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(41, 1)
    test.assert(as5600.angle_read_of(d) == None)

@test
fn test_one_burst_from_the_status_would_read_the_raw_angle_twice() [io, hw]
    // The double's reading of the pointer rule: this is why the driver
    // does not read the status and the angle in one transaction.
    let c = chip()
    let d = dut(c)
    set_raw(c, 0x0ABC)
    test.assert(as5600.zpos_write(d, 0x0100))
    var b: DevBytes = Vec.new()
    test.assert(d.read_regs(0x0B, 5, var b))
    test.assert_eq(b[1] as Int, 0x0A)
    test.assert_eq(b[2] as Int, 0xBC)
    test.assert_eq(b[3] as Int, 0x0A)
    test.assert_eq(b[4] as Int, 0xBC)
    // The angle register itself is the raw angle less ZPOS.
    test.assert_eq(int_or(as5600.angle_value_read(d)), 0x09BC)

// ── The zero and the range ───────────────────────────────────────────

@test
fn test_angle_set_zero_writes_zpos_and_reads_it_back() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(as5600.zpos_write(d, 4095))
    test.assert_eq(word(c, 0x01), 4095)
    test.assert(as5600.zpos_write(d, 0))
    test.assert_eq(word(c, 0x01), 0)

@test
fn test_a_zero_outside_the_twelve_bits_is_refused_and_sends_nothing() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(not as5600.zpos_write(d, -1))
    test.assert(not as5600.zpos_write(d, 4096))
    test.assert(not as5600.mpos_write(d, 4096))
    test.assert(not as5600.mang_write(d, -1))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_register_that_ignores_the_write_is_reported() [io, hw]
    let c = chip()
    let d = dut(c)
    c.ro.insert(0x02, 1)
    test.assert(not as5600.zpos_write(d, 0x055))
    // The write was acknowledged and the read back differs.
    test.assert_eq(word(c, 0x01), 0)

@test
fn test_a_part_that_refuses_the_write_or_the_readback() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(42, 0)
    test.assert(not as5600.zpos_write(d, 5))
    c.st.insert(42, 1)
    c.st.insert(41, 0)
    test.assert(not as5600.zpos_write(d, 5))

@test
fn test_zero_here_copies_the_raw_angle_into_zpos() [io, hw]
    let c = chip()
    let d = dut(c)
    set_raw(c, 2222)
    test.assert(as5600.zero_here_of(d))
    test.assert_eq(word(c, 0x01), 2222)
    test.assert_eq(int_or(as5600.angle_value_read(d)), 0)

@test
fn test_the_maximum_angle_is_zero_or_more_than_18_degrees() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(not as5600.mang_write(d, 204))
    test.assert(not as5600.mang_write(d, 1))
    test.assert_eq(at(c.st, 99), 0)
    test.assert(as5600.mang_write(d, 205))
    test.assert_eq(word(c, 0x05), 205)
    test.assert(as5600.mang_write(d, 0))
    test.assert_eq(word(c, 0x05), 0)

@test
fn test_the_output_scales_over_the_programmed_range() [io, hw]
    let c = chip()
    let d = dut(c)
    // A range of 180 degrees: half a turn of the shaft is all 4096 counts.
    test.assert(as5600.mang_write(d, 2048))
    set_raw(c, 1024)
    test.assert_eq(int_or(as5600.angle_value_read(d)), 2048)
    set_raw(c, 3000)
    test.assert_eq(int_or(as5600.angle_value_read(d)), 4095)

@test
fn test_a_range_is_two_positions_more_than_18_degrees_apart() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(as5600.range_write(d, 100, 305))
    test.assert_eq(word(c, 0x01), 100)
    test.assert_eq(word(c, 0x03), 305)
    // The span wraps through 0.
    test.assert(as5600.range_write(d, 4000, 200))
    test.assert_eq(word(c, 0x01), 4000)
    test.assert_eq(word(c, 0x03), 200)
    log_clear(c)
    // Less than the least span, an equal pair, and values outside 12 bits.
    test.assert(not as5600.range_write(d, 100, 304))
    test.assert(not as5600.range_write(d, 100, 100))
    test.assert(not as5600.range_write(d, -1, 500))
    test.assert(not as5600.range_write(d, 4096, 500))
    test.assert(not as5600.range_write(d, 0, -1))
    test.assert(not as5600.range_write(d, 0, 4096))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_range_stops_when_the_second_write_fails() [io, hw]
    let c = chip()
    let d = dut(c)
    // ZPOS is written and read back (one write), then MPOS is refused.
    c.st.insert(42, 1)
    test.assert(not as5600.range_write(d, 100, 500))
    test.assert_eq(word(c, 0x01), 100)
    test.assert_eq(word(c, 0x03), 0)

@test
fn test_the_settings_are_one_read_of_nine_registers() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x00, 0x03)
    c.regs.insert(0x01, 0x01)
    c.regs.insert(0x02, 0x23)
    c.regs.insert(0x03, 0x04)
    c.regs.insert(0x04, 0x56)
    c.regs.insert(0x05, 0x07)
    c.regs.insert(0x06, 0x89)
    c.regs.insert(0x07, 0xC1)
    c.regs.insert(0x08, 0x2D)
    match as5600.settings_read(d)
        Some(s) =>
            test.assert_eq(s.zmco, 3)
            test.assert_eq(s.zpos, 0x123)
            test.assert_eq(s.mpos, 0x456)
            test.assert_eq(s.mang, 0x789)
            test.assert_eq(s.conf_raw, 0xC12D)
        None    => test.assert(false)
    log_is(c, [2, 0x36, 0x00, 9, -1])

@test
fn test_the_burn_count_is_zmco_in_two_bits() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert_eq(int_or(as5600.burn_count(d)), 0)
    c.regs.insert(0x00, 0xFE)
    test.assert_eq(int_or(as5600.burn_count(d)), 2)

@test
fn test_the_gain_and_the_magnitude_are_one_read_of_three_registers() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x1A, 128)
    c.regs.insert(0x1B, 0x0A)
    c.regs.insert(0x1C, 0xBC)
    match as5600.gain_read(d)
        Some(g) =>
            test.assert_eq(g.agc, 128)
            test.assert_eq(g.magnitude, 0x0ABC)
        None    => test.assert(false)
    log_is(c, [2, 0x36, 0x1A, 3, -1])
    c.st.insert(60, 1)
    c.regs.insert(0x1B, 0xFA)
    match as5600.gain_read(d)
        Some(g) => test.assert_eq(g.magnitude, 0x0ABC)
        None    => test.assert(false)

// ── The configuration ────────────────────────────────────────────────

@test
fn test_the_conf_register_is_read_as_its_fields() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x07, 0xF7)
    c.regs.insert(0x08, 0xAB)
    let f = conf_or(as5600.conf_read(d))
    test.assert_eq(f.power_mode, 3)
    test.assert_eq(f.hysteresis, 2)
    test.assert_eq(f.output_stage, 2)
    test.assert_eq(f.pwm_freq, 2)
    test.assert_eq(f.slow_filter, 3)
    test.assert_eq(f.fast_threshold, 5)
    test.assert(f.watchdog)
    log_is(c, [2, 0x36, 0x07, 2, -1])

@test
fn test_a_conf_write_keeps_the_reserved_bits_and_reads_back() [io, hw]
    let c = chip()
    let d = dut(c)
    let f = As5600Conf { power_mode: 1,
        hysteresis: 3,
        output_stage: 1,
        pwm_freq: 3,
        slow_filter: 2,
        fast_threshold: 7,
        watchdog: true }
    test.assert(as5600.conf_write(d, f))
    // 0xC000 from the factory, then the fields.
    test.assert_eq(at(c.regs, 0x07), 0xC0 | 0x3E)
    test.assert_eq(at(c.regs, 0x08), 0xDD)
    log_is(c, [2, 0x36, 0x07, 2, -1, 1, 0x36, 0x07, 0xFE, 0xDD, -1, 2, 0x36, 0x07, 2, -1])

@test
fn test_a_conf_write_reports_a_part_that_does_not_hold_it() [io, hw]
    let c = chip()
    let d = dut(c)
    let f = As5600Conf { power_mode: 1,
        hysteresis: 0,
        output_stage: 0,
        pwm_freq: 0,
        slow_filter: 0,
        fast_threshold: 0,
        watchdog: false }
    c.ro.insert(0x08, 1)
    test.assert(not as5600.conf_write(d, f))
    // A part that leaves after the read, after the write.
    let e = chip()
    let g = dut(e)
    e.st.insert(41, 1)
    test.assert(not as5600.conf_write(g, f))
    let h = chip()
    let k = dut(h)
    h.st.insert(42, 0)
    test.assert(not as5600.conf_write(k, f))
    let m = chip()
    let n = dut(m)
    m.st.insert(41, 0)
    test.assert(not as5600.conf_write(n, f))

@test
fn test_each_field_changes_alone() [io, hw]
    let c = chip()
    let d = dut(c)
    // Start from every field set, so a field that spills shows.
    c.regs.insert(0x07, 0xFF)
    c.regs.insert(0x08, 0xFF)
    test.assert(as5600.power_mode_write(d, 1))
    test.assert_eq(at(c.regs, 0x08), 0xFD)
    test.assert(as5600.hysteresis_write(d, 0))
    test.assert_eq(at(c.regs, 0x08), 0xF1)
    test.assert(as5600.output_stage_write(d, 1))
    test.assert_eq(at(c.regs, 0x08), 0xD1)
    test.assert(as5600.pwm_freq_write(d, 0))
    test.assert_eq(at(c.regs, 0x08), 0x11)
    test.assert(as5600.slow_filter_write(d, 1))
    test.assert_eq(at(c.regs, 0x07), 0xFD)
    test.assert(as5600.fast_filter_write(d, 0))
    test.assert_eq(at(c.regs, 0x07), 0xE1)
    test.assert(as5600.watchdog_write(d, false))
    test.assert_eq(at(c.regs, 0x07), 0xC1)
    test.assert(as5600.watchdog_write(d, true))
    test.assert_eq(at(c.regs, 0x07), 0xE1)
    // Nothing else moved.
    test.assert_eq(at(c.regs, 0x08), 0x11)

@test
fn test_a_field_value_outside_its_width_is_refused_and_sends_nothing() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(not as5600.power_mode_write(d, 4))
    test.assert(not as5600.power_mode_write(d, -1))
    test.assert(not as5600.hysteresis_write(d, 4))
    test.assert(not as5600.output_stage_write(d, 3))
    test.assert(not as5600.pwm_freq_write(d, 4))
    test.assert(not as5600.slow_filter_write(d, 4))
    test.assert(not as5600.fast_filter_write(d, 8))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_field_write_to_a_part_that_does_not_answer() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(4, 0)
    test.assert(not as5600.power_mode_write(d, 1))
    test.assert(not as5600.watchdog_write(d, true))

@test
fn test_the_generic_word_and_field_accessors() [io, hw]
    let c = chip()
    let d = dut(c)
    // A 12-bit value at any high byte, written and read back.
    test.assert(as5600.word12_write(d, 0x03, 0x0AB))
    test.assert_eq(int_or(as5600.word12_read(d, 0x03)), 0x0AB)
    test.assert(not as5600.word12_write(d, 0x03, 5000))
    // A CONF field by its shift and width: HYST is two bits at bit 2.
    test.assert(as5600.conf_field_write(d, 2, 2, 3))
    test.assert_eq(at(c.regs, 0x08), 0x0C)
    test.assert(not as5600.conf_field_write(d, 2, 2, 4))

// ── The device types over absent hardware ────────────────────────────
//
// The host's handles are absent hardware: every transfer is refused, so
// each method answers its "no part" value.  This runs the lines of the
// type that forward to the functions above.

@test
fn test_the_type_over_absent_hardware() [io, hw]
    let p = As5600.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, wiring())
    test.assert(not p.begin())
    test.assert(not p.set_clockwise(true))
    test.assert(not p.set_clockwise(false))
    test.assert(p.status() == None)
    test.assert(p.raw_angle() == None)
    test.assert(p.angle() == None)
    test.assert(p.gain() == None)
    test.assert(p.settings() == None)
    test.assert(p.burns() == None)
    test.assert(not p.set_zpos(5))
    test.assert(not p.set_mpos(5))
    test.assert(not p.set_mang(300))
    test.assert(not p.set_range(0, 300))
    test.assert(not p.zero_here())
    test.assert(p.conf() == None)
    let f = As5600Conf { power_mode: 0,
        hysteresis: 0,
        output_stage: 0,
        pwm_freq: 0,
        slow_filter: 0,
        fast_threshold: 0,
        watchdog: false }
    test.assert(not p.set_conf(f))
    test.assert(not p.set_power_mode(1))
    test.assert(not p.set_hysteresis(1))
    test.assert(not p.set_output_stage(1))
    test.assert(not p.set_pwm_freq(1))
    test.assert(not p.set_slow_filter(1))
    test.assert(not p.set_fast_filter(1))
    test.assert(not p.set_watchdog(true))
    test.assert(p.angle_read() == None)
    test.assert(not p.angle_set_zero(100))

@test
fn test_the_type_with_a_dir_pin_over_absent_hardware() [io, hw]
    let p = As5600.attach_with_dir(BoardI2c { id: 0 }, BoardGpio { id: 0 }, wiring(), 7)
    test.assert(not p.begin())
    // The pin is driven, which absent hardware accepts.
    test.assert(p.set_clockwise(true))
    test.assert(p.set_clockwise(false))
